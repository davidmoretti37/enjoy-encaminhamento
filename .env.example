# ===========================================
# Environment Configuration Template
# Copy this file to .env and fill in values
# ===========================================

# ---- Supabase Configuration ----
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is required for admin operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Application Configuration ----
NODE_ENV=development
PORT=5001
APP_URL=http://localhost:5001

# Node.js networking configuration (fixes DNS/timeout issues)
NODE_OPTIONS="--dns-result-order=ipv4first"

# ---- LLM / AI Configuration ----
# Get API key from: https://openrouter.ai/keys
# Used for: AI summaries (Llama 3.1 70B) + embeddings (text-embedding-3-small)
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=anthropic/claude-haiku-4-5-20250414

# ---- Email Service (Gmail SMTP) ----
# For Gmail: Enable 2FA and create an App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# ---- Per-unit institutional mailboxes (report #14, optional) ----
# When set, agenda emails for that unit are sent from its institutional address
# (Outlook/Microsoft 365). Falls back to the global SMTP_* above if unset.
# For Outlook set the global SMTP_HOST=smtp.office365.com and SMTP_PORT=587.
# Note: O365 usually requires SMTP_USER == the FROM address, and an app password
# if the mailbox has MFA. SMTP AUTH must be enabled on each mailbox.
# EMAIL_FROM_UBERLANDIA=uberlandia@anecrh.com.br
# SMTP_USER_UBERLANDIA=uberlandia@anecrh.com.br
# SMTP_PASS_UBERLANDIA=
# SMTP_HOST_UBERLANDIA=smtp.office365.com   # optional; defaults to global SMTP_HOST
# SMTP_PORT_UBERLANDIA=587                   # optional; defaults to global SMTP_PORT
# EMAIL_FROM_IPATINGA=ipatinga@anecrh.com.br
# SMTP_USER_IPATINGA=ipatinga@anecrh.com.br
# SMTP_PASS_IPATINGA=
# SMTP_HOST_IPATINGA=smtp.office365.com
# SMTP_PORT_IPATINGA=587

# ---- Zoom Integration (Optional) ----
# Get these from: Zoom App Marketplace > Server-to-Server OAuth App
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Google Calendar/Meet Integration (Optional) ----
# Get these from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Frontend Configuration ----
# Variables prefixed with VITE_ are exposed to the frontend
VITE_APP_TITLE=Recruitment Platform
VITE_APP_DESCRIPTION=AI-Powered Recruitment Platform
VITE_APP_LOGO=

# These should match the backend Supabase config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Analytics (Optional) ----
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_SITE_ID=
