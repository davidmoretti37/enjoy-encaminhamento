{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/trpc.ts": {
      "includeFiles": "backend/_bundled.mjs",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/autentique",
      "destination": "/api/webhooks/autentique"
    },
    {
      "source": "/api/trpc/:path*",
      "destination": "/api/trpc"
    },
    {
      "source": "/trpc/:path*",
      "destination": "/api/trpc"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-overdue-payments",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reconcile-estagio-billing",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/expiry-notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/monthly-report-reminders",
      "schedule": "0 9 5 * *"
    }
  ]
}
